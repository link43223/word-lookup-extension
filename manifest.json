{
  "manifest_version": 3,
  "name": "点词即查",
  "version": "1.3.2",
  "description": "阅读英文网页时，点击单词查看音标、发音和中文释义。",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "点词即查：点击英文单词查看释义",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://dict.youdao.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
